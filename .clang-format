---
# 基础参考风格
BasedOnStyle: LLVM
# 缩进宽度（保持 4，这是你唯一想要的空格）
IndentWidth: 4
# 指针对齐（int* a 变成 int *a，节省一个左边空格）
PointerAlignment: Right

# --- 关键：关闭几乎所有空格 ---

# 赋值号两边不加空格 (a=10 而不是 a = 10)
SpaceBeforeAssignmentOperators: false
# 括号前不加空格 (if(a==b) 而不是 if (a == b))
SpaceBeforeParens: Never
# 尖括号内不加空格 (vector<int> 而不是 vector< int >)
SpacesInAngles: false
# 逻辑非后面不加空格 (!a 而不是 ! a)
SpaceAfterLogicalNot: false
# 类型转换后面不加空格 ((int)a 而不是 (int) a)
SpaceAfterCStyleCast: false
# 方括号前不加空格 (int a[10] 而不是 int a [10])
SpaceBeforeSquareBrackets: false
# 圆括号两端不加内边距空格 ( (a+b) 而不是 ( a+b ) )
SpacesInParentheses: false
# 方括号内不加空格 (a[i] 而不是 a[ i ])
SpacesInSquareBrackets: false

# --- 极致紧凑结构 ---

# 允许短的 if 和 else 写在同一行
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
# 允许短的循环写在同一行
AllowShortLoopsOnASingleLine: true
# 允许短的函数（如 get_val）写在同一行
AllowShortFunctionsOnASingleLine: All
# 强制大括号不换行
BreakBeforeBraces: Attach
# 不限制单行长度（防止强制换行破坏紧凑感）
ColumnLimit: 0

# 连续赋值对齐（可选，如果想要更整齐可以开启，不想要就设为 false）
AlignConsecutiveAssignments: false
---
